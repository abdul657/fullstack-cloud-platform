{
  "name": "fullstack-cloud-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev --workspace @platform/api\" \"npm run dev --workspace @platform/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @platform/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
